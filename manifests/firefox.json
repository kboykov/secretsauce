{
  "manifest_version": 2,
  "name": "SecretSauce",
  "version": "1.4.1",
  "description": "Detect exposed secrets, API keys and endpoints on any page, with built-in recon tabs.",
  "author": "K. Boykov",
  "browser_specific_settings": {
    "gecko": {
      "id": "secretsauce@extension",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "browser_action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SecretSauce — open findings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-secretsauce": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Open SecretSauce for the current tab"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared.js",
        "detect.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": [
      "shared.js",
      "background.js"
    ],
    "persistent": false
  }
}
